{
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/android/.gradle/**": true,
    "**/android/build/**": true,
    "**/ios/build/**": true,
    "**/.expo/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.next/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/android/.gradle": true,
    "**/android/build": true,
    "**/ios/build": true,
    "**/.expo": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true
  },
  "typescript.tsserver.maxTsServerMemory": 2048,
  "typescript.disableAutomaticTypeAcquisition": true
}
